---
import BaseLayout from '../layouts/BaseLayout.astro';

const handbook = 'https://github.com/aeroflow-air/platform-handbook';
const adrs = [
  {
    id: 'ADR-0001',
    title: 'Repository naming convention',
    status: 'accepted',
    href: `${handbook}/blob/main/docs/decisions/0001-repository-naming-convention.md`,
  },
  {
    id: 'ADR-0002',
    title: 'Infrastructure as code — Bicep with typed module contracts',
    status: 'accepted',
    href: `${handbook}/blob/main/docs/decisions/0002-infrastructure-as-code-bicep.md`,
  },
  {
    id: 'ADR-0003',
    title: 'Public site and engineering blog on GitHub Pages',
    status: 'accepted',
    href: `${handbook}/blob/main/docs/decisions/0003-public-site-and-engineering-blog.md`,
    note: 'This site implements it.',
  },
  {
    id: 'ADR-0004',
    title: 'Functional-style C# for service code',
    status: 'accepted',
    href: `${handbook}/blob/main/docs/decisions/0004-functional-style-csharp.md`,
  },
  {
    id: 'ADR-0005',
    title: 'Quality skill lives in the squad, not a QA department',
    status: 'accepted',
    href: `${handbook}/blob/main/docs/decisions/0005-squad-integrated-quality.md`,
  },
];
---

<BaseLayout
  title="Platform"
  description="Links into AeroFlow platform-handbook ADRs. Decisions are not copied here."
  current="platform"
  track="product"
>
  <div class="wrap wrap--narrow">
    <h1>Platform</h1>
    <p class="lede">
      Decision records live in
      <a href={handbook}>platform-handbook</a>. This page only links out — we do
      not duplicate ADR text on this site.
    </p>

    <h2>Architecture decision records</h2>
    <ul class="adr-list">
      {
        adrs.map((adr) => (
          <li>
            <a href={adr.href}>
              <strong>{adr.id}</strong>: {adr.title}
            </a>
            <p class="meta">Status: {adr.status}{adr.note ? `. ${adr.note}` : ''}</p>
          </li>
        ))
      }
    </ul>

    <h2>Related repos</h2>
    <ul>
      <li>
        <a href="https://github.com/aeroflow-air/template-dotnet-service">
          template-dotnet-service
        </a>
        — golden-path ASP.NET Core starting point
      </li>
      <li>
        <a href="https://github.com/aeroflow-air/aeroflow-workflows">
          aeroflow-workflows
        </a>
        — reusable GitHub Actions workflows
      </li>
      <li>
        <a href="https://github.com/aeroflow-air/svc-flight-status">svc-flight-status</a>
        — first service, flight lifecycle
      </li>
      <li>
        <a href="https://github.com/aeroflow-air/svc-gate-allocation">svc-gate-allocation</a>
        — second service, gate allocation
      </li>
      <li>
        <a href="https://github.com/aeroflow-air/site-customer">site-customer</a>
        — this site
      </li>
    </ul>

    <p class="meta">
      Prefer a PR against the handbook if a decision is unsettled. Blog posts
      narrate accepted (or deliberately experimental) work; they are not a
      substitute for ADRs.
    </p>
  </div>
</BaseLayout>
