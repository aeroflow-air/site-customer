---
interface Props {
  current?: 'home' | 'engineering' | 'platform';
  track?: 'product' | 'engineering';
}

const { current, track = current === 'engineering' ? 'engineering' : 'product' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class:list={['site-header', track === 'engineering' && 'site-header--eng']}>
  <div class="wrap site-header__inner">
    <a class="brand" href={base}>AeroFlow Air</a>
    <nav aria-label="Primary">
      <ul class="nav">
        <li>
          <a
            class="nav__product"
            href={base}
            aria-current={current === 'home' ? 'page' : undefined}
          >
            Product
          </a>
        </li>
        <li>
          <a
            class="nav__eng"
            href={`${base}engineering/`}
            aria-current={current === 'engineering' ? 'page' : undefined}
          >
            Engineering
          </a>
        </li>
        <li>
          <a
            href={`${base}platform/`}
            aria-current={current === 'platform' ? 'page' : undefined}
          >
            Platform
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
